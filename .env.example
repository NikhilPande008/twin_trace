# Copy to .env and fill in. .env is gitignored — never commit the real file.

# ── Nebius Token Factory (OpenAI-compatible) ─────────────────────────────────
NEBIUS_PROJECT_ID=
NEBIUS_API_KEY=
# Base URL confirmed live 2026-10-21 (check_models HTTP 200):
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Model tiers (defaults in ddp/config.py). Override only after check_models shows the id is live.
# MODEL_TRIAGE=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# MODEL_REASONING=nvidia/nemotron-3-super-120b-a12b
# MODEL_DISPOSITION=nvidia/Nemotron-3-Ultra-550b-a55b
# LLM_TIMEOUT_S=90

# ── Calculator of record ─────────────────────────────────────────────────────
# local | nebius-sandbox   (nebius-sandbox is a stub until TASKS.md T1.3 is done)
COMPUTE_BACKEND=local

# ── Adverse-media screening (not built yet — TASKS.md T2.x) ──────────────────
TAVILY_API_KEY=

