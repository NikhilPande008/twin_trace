# Officer sign-in (OpenID Connect via st.login). Copy to .streamlit/secrets.toml (gitignored) and
# fill in from your identity provider's app registration. Without this file the app runs in
# offline mode and the officer ID on a decision is self-asserted (and labelled so).
# Needs: pip install -r requirements.txt (Authlib).

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = ""            # a long random string
client_id = ""
client_secret = ""
server_metadata_url = ""      # the provider's /.well-known/openid-configuration URL

# Only these accounts may record a decision. Key: the email the provider reports (quoted);
# value: the officer ID written to the ledger. The email itself is never written to the ledger.
[officers]
"officer.one@bank.example" = "PO-001"
