# ── Secrets: never commit ─────────────────────────────────────────────────────
.env
.env.*
!.env.example
.streamlit/secrets.toml
.claude/settings.local.json

# ── Local data: SQLite databases are rebuilt by `python -m scripts.seed_db` ───
*.sqlite3
*.sqlite3-*
*.db

# ── Generated artifacts that are not evidence ────────────────────────────────
# Decision packages exported for review (scripts/export_decision.py writes to cwd)
decision-package-*.json
# Mock eval reports are harness self-tests; only dated live/gate-only runs are evidence
evals/*-mock.md
evals/*-mock.json
evals/**/RUN-*-mock/
evals/**/*-mock.md
evals/**/*-mock.json
*.log

# ── Python build / cache ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ── Editors / OS ──────────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
*~

# ── Internal working documents: kept locally, never pushed ───────────────────
# The public repo is the product: README, LICENSE, code, tests, domain data, evals and two
# reader-facing docs. Session notes, plans, decision logs, audits and drafts stay on this machine.
/CLAUDE.md
/HANDOFF.md
/TASKS.md
/DECISIONS.md
/CONTEXT.md
/CHANGES_SINCE_BASELINE.md
/DOMAIN.md
/design/
/.claude/
/docs/*
!/docs/IMPACT.md
!/docs/CLAIMS_REGISTER.md

# ── External datasets: downloaded by the human, never committed ──────────────
